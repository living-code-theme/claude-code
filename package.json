{
  "name": "living-code-claude-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Living Code for Claude Code: prompt accents, permissions, messages, diffs and subagent colors in four native custom themes.",
  "license": "MIT",
  "author": "Living Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/living-code-theme/claude-code.git"
  },
  "homepage": "https://living-code.dev/ports/claude-code/",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.22"
  },
  "livingCode": {
    "kind": "files"
  },
  "scripts": {
    "build": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node --test test/*.test.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "palette:update": "node scripts/update-palette.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {}
}
